@startuml UC6_6
left to right direction

actor "Dipendente" as dp
actor "Provider LLM" as llm

rectangle "NEXUM Concierge" {
    usecase "UC6: Registrazione richiesta ferie o permessi" as UC6
    usecase "UC6.6: Annullamento preparazione richiesta" as UC6_6
}

dp -- UC6
UC6 -- llm

UC6 <.. UC6_6 : <<extend>>
note on link
Il dipendente rifiuta la conferma
o annulla la preparazione
end note

@enduml